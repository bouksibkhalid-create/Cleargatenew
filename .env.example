# ==================================================
# Due Diligence App - Environment Variables Template
# ==================================================
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the repo root
# 2. Fill in actual values (NEVER commit .env!)
# 3. For Netlify production, set these in the dashboard
#
# ==================================================

# --------------------------------------------------
# Neo4j Database
# --------------------------------------------------
NEO4J_URI=neo4j+ssc://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# --------------------------------------------------
# API Keys
# --------------------------------------------------
# Get at: https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=your_opensanctions_api_key

# Get at: https://sanctions.io/
SANCTIONS_IO_API_KEY=your_sanctions_io_api_key

# --------------------------------------------------
# AI Analysis — Anthropic Claude (M4)
# --------------------------------------------------
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_ANALYSIS_MODEL=claude-sonnet-4-20250514
AI_ANALYSIS_MAX_TOKENS=1024
AI_ANALYSIS_TIMEOUT=30.0

# --------------------------------------------------
# Adverse Media (M2)
# --------------------------------------------------
# Option A: Serper.dev (recommended) — https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Option B: Google Custom Search — https://developers.google.com/custom-search/v1
# GOOGLE_CSE_API_KEY=your_google_api_key_here
# GOOGLE_CSE_ENGINE_ID=your_custom_search_engine_id_here

ADVERSE_MEDIA_PROVIDER=serper
ADVERSE_MEDIA_MAX_QUERIES=5
ADVERSE_MEDIA_QUERY_DELAY=0.2
ADVERSE_MEDIA_DEDUP_THRESHOLD=85

# --------------------------------------------------
# Configuration
# --------------------------------------------------
LOG_LEVEL=INFO
DEFAULT_FUZZY_THRESHOLD=80
DEFAULT_GRAPH_DEPTH=2
OPENSANCTIONS_TIMEOUT=5.0
SANCTIONS_IO_TIMEOUT=5.0

# --------------------------------------------------
# Frontend (Local Development)
# --------------------------------------------------
VITE_API_URL=http://localhost:8888

# For Netlify: VITE_API_URL=/.netlify/functions
