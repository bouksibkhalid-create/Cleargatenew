{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily-monitor",
            "schedule": "0 6 * * *"
        }
    ],
    "buildCommand": "cd frontend && npm install --include=dev && npm run build",
    "outputDirectory": "frontend/dist"
}